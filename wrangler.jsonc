{
  "$schema": "https://unpkg.com/wrangler@4.128.0/config-schema.json",
  // Worker name must stay mac-never-sleep: xyz-ai-gateway binds NEVER_SLEEP to it
  // and strips the /never-sleep prefix. Do not attach xyz-ai.app here.
  "name": "mac-never-sleep",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-01",
  // Pair/start is rate-limited in-worker; do not expose workers.dev/preview around the gateway.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Per-location abuse protection; preserve headroom for old one-second clients.
  "ratelimits": [
    { "name": "DEVICE_IP_RATE", "namespace_id": "76351001", "simple": { "limit": 540, "period": 60 } },
    { "name": "DEVICE_EDGE_RATE", "namespace_id": "76351002", "simple": { "limit": 12060, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BOARD", "class_name": "BoardHub" }
    ]
  },
  "migrations": [
    // Workers Free only supports SQLite-backed DOs (API code 10097).
    { "tag": "v1", "new_sqlite_classes": ["BoardHub"] }
  ]
}
